{
  "name": "release-lens",
  "version": "1.0.0",
  "description": "Compara dos releases (varios repos, API y pantallas) y explica en lenguaje de usuario qué cambió, qué riesgos hay y qué probar.",
  "type": "module",
  "private": true,
  "bin": {
    "release-lens": "./bin/release-lens.mjs"
  },
  "scripts": {
    "compare": "tsx src/cli.ts",
    "demo": "node demo/setup-demo.mjs && tsx src/cli.ts --config demo/.work/releaselens.demo.json --out release-report",
    "report": "node scripts/open-report.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["qa", "release-notes", "jenkins", "git", "openapi", "playwright", "visual-diff", "jira"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "1.65.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.0"
  }
}
